# Match POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB in ../.env.
# URL-encode any special characters in the database password.
DATABASE_URL=postgresql://meditrack:replace-with-local-password@127.0.0.1:5432/meditrack?schema=public
REDIS_URL=redis://127.0.0.1:6379
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_REQUEST_TIMEOUT_MS=240000
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Generate distinct random secrets before using authentication.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
API_ORIGIN=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MediTrack <no-reply@meditrack.local>
